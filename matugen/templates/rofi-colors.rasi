/* Автогенерация matugen */

* {
    bg-main:      {{colors.surface.default.hex}};
    bg-overlay:   {{colors.surface_variant.default.hex}};
    bg-selected:  {{colors.primary_container.default.hex}};
    bg-urgent:    {{colors.error_container.default.hex}};

    fg-primary:   {{colors.on_surface.default.hex}};
    fg-secondary: {{colors.on_surface_variant.default.hex}};
    fg-selected:  {{colors.on_primary_container.default.hex}};
    fg-urgent:    {{colors.on_error_container.default.hex}};

    accent:       {{colors.primary.default.hex}};
    accent-alt:   {{colors.tertiary.default.hex}};
    border-color: {{colors.outline_variant.default.hex}};

    surface:      {{colors.surface_container.default.hex}};
    surface-high: {{colors.surface_container_high.default.hex}};
}
